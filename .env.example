# ====================================================================
# CONFIGURACIÓN DE BASE DE DATOS
# Usa estos valores exactos para tu conexión a MSSQLEXPRESS
# ====================================================================

# Servidor SQL Server
DB_SERVER=MSSQLEXPRESS

# Usuario Windows (Autenticación NTLM)
DB_USER=MSJalero

# Dominio (. = usuario local)
DB_DOMAIN=.

# Nombre de la Base de Datos
DB_NAME=FlexWebApp

# Puerto Node.js
PORT=5000

# Entorno
NODE_ENV=development

# CORS - Origen del frontend
FRONTEND_URL=http://localhost:5173

# ====================================================================
# NOTAS IMPORTANTES
# ====================================================================
# 1. NO incluyas contraseña - estamos usando Autenticación Windows
# 2. Copia este archivo como ".env" (sin el .example)
# 3. NO commits el .env a Git (está en .gitignore)
# 4. Asegúrate que MSJalero es tu usuario de Windows logueado
# 5. El servidor debe estar en modo MSSQLEXPRESS (no localhost)
