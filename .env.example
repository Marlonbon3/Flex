# ====================================================================
# CONFIGURACIÓN DE BASE DE DATOS - FLEX-WEBAPP
# 
# INSTRUCCIONES:
# 1. Reemplaza TU_COMPUTADORA con tu nombre de PC (escribe: hostname)
# 2. Reemplaza TU_CONTRASEÑA_SA con tu contraseña del usuario sa
# 3. Guarda este archivo como .env en la raíz del proyecto
# ====================================================================

# Servidor SQL Server (CAMBIAR: TU_COMPUTADORA)
DB_SERVER=TU_COMPUTADORA\SQLEXPRESS

# Usuario SA (usuario por defecto de SQL Server)
DB_USER=sa

# Contraseña del usuario SA (CAMBIAR: TU_CONTRASEÑA_SA)
DB_PASSWORD=TU_CONTRASEÑA_SA

# Nombre de la Base de Datos (NO CAMBIAR)
DB_NAME=FlexWebApp

# Puerto Node.js (NO CAMBIAR)
PORT=5000

# Ambiente (NO CAMBIAR)
NODE_ENV=development

# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:5173

# Entorno
NODE_ENV=development

# CORS - Origen del frontend
FRONTEND_URL=http://localhost:5173

# ====================================================================
# NOTAS IMPORTANTES
# ====================================================================
# 1. NO incluyas contraseña - estamos usando Autenticación Windows
# 2. Copia este archivo como ".env" (sin el .example)
# 3. NO commits el .env a Git (está en .gitignore)
# 4. Asegúrate que MSJalero es tu usuario de Windows logueado
# 5. El servidor debe estar en modo MSSQLEXPRESS (no localhost)
